rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /project_green/shared_state {
      allow read, write: if true;
    }

    match /project_green_presence/{sessionId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
